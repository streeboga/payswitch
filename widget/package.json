{
  "name": "@payswitch/js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/payswitch.js",
  "module": "dist/payswitch.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/payswitch.mjs",
      "require": "./dist/payswitch.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "happy-dom": "^17.4.0"
  }
}
